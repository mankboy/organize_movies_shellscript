# Media Organizer - Settings
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Or just run the script — the GUI will prompt for keys and save them here.
# Hold SHIFT when launching to re-configure saved keys.

# TMDB API key (free, register at https://www.themoviedb.org/settings/api)
export TMDB_API_KEY=''

# Anthropic API key (optional fallback, from https://console.anthropic.com/)
export ANTHROPIC_API_KEY=''

# Last selected Permute version (none, 3, or 4)
export PERMUTE_LAST_CHOICE='none'
